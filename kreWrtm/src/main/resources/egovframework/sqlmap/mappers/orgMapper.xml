<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="kr.co.hivesys.company.mapper.OrgMapper">

  <!-- OrgInfoVO 매핑 -->
  <resultMap id="OrgInfoMap" type="orgVo">
    <id property="orgId" column="ORG_ID"/>
    <!-- BaseVO -->
    <result property="regDate" column="REG_DATE"/>
    <result property="createdAt" column="CREATED_AT"/>
    <result property="updatedAt" column="UPDATED_AT"/>
    <result property="tagId" column="TAG_ID"/>
    <result property="searchType" column="SEARCH_TYPE"/>
    <result property="searchValue" column="SEARCH_VALUE"/>
    <result property="sDate" column="S_DATE"/>
    <result property="eDate" column="E_DATE"/>
    <!-- CompanyVO -->
    <result property="companyCode" column="COMPANY_CODE"/>
    <result property="companyName" column="COMPANY_NAME"/>
    <result property="userType" column="USER_TYPE"/>
    <result property="dirMb" column="DIR_MB"/>
    <result property="dirRegDt" column="DIR_REG_DT"/>
    <result property="todayCnt" column="TODAY_CNT"/>
    <result property="rsrqAvg" column="RSRQ_AVG"/>
    <!-- OrgVO -->
    
    <result property="orgName" column="ORG_NAME"/>
</resultMap>

  <!-- SELECT: PK 단건 -->
  <select id="select" parameterType="orgVO" resultMap="OrgInfoMap">
    SELECT org_id, company_code, org_name, created_at, updated_at
    FROM TBL_ORG_INFO
    WHERE 1=1
    <!-- <if test="orgId != null and orgId neq '' ">
	   and org_id = #{orgId}
    </if> -->
    <if test="companyCode != null and companyCode neq '' ">
	   and company_code = #{companyCode}
    </if>
  </select>

  <!-- SELECT: 회사 코드별 목록 -->
  <select id="selectList" parameterType="orgVO" resultMap="OrgInfoMap">
    SELECT org_id, company_code, org_name, created_at, updated_at
    FROM TBL_ORG_INFO
    WHERE 1=1 
    <if test="searchType!=null and searchType neq ''">
			<choose>
				<when test="searchType eq 'orgName' ">
					and org_name LIKE CONCAT('%',#{searchValue},'%')
				</when>
				<when test="searchType eq 'company_name' ">
					and company_name LIKE CONCAT('%',#{searchValue},'%')
				</when>
				<otherwise>
					and
					(
					org_name LIKE CONCAT('%',#{searchValue},'%')
					or
					company_name LIKE CONCAT('%',#{searchValue},'%')
					)
				</otherwise>
			</choose>
		</if>
    ORDER BY org_name ASC
  </select>

  <!-- INSERT: AUTO_INCREMENT 키 반환 -->
  <insert id="insert" parameterType="orgVO"
          useGeneratedKeys="true" keyProperty="orgId">
    INSERT INTO TBL_ORG_INFO
      (company_code, org_name)
    VALUES
      (#{companyCode}, #{orgName})
  </insert>

  <!-- UPDATE: PK 기준 -->
  <update id="update" parameterType="orgVO">
    UPDATE TBL_ORG_INFO
    SET
      company_code = #{companyCode},
      org_name     = #{orgName}
    WHERE org_id = #{orgId}
  </update>

  <!-- DELETE: PK 기준 -->
  <delete id="deleteChk" parameterType="orgVO">
    DELETE FROM TBL_ORG_INFO
    WHERE org_id = #{orgId}
  </delete>

</mapper>
