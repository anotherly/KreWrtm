<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="kr.co.hivesys.company.mapper.OrgMapper">

  <!-- OrgInfoVO 매핑 -->
  <resultMap id="OrgInfoMap" type="orgVo">
    <id property="orgId" column="ORG_ID"/>
    <!-- BaseVO -->
    <result property="regDate" column="REG_DATE"/>
    <result property="createdAt" column="CREATED_AT"/>
    <result property="updatedAt" column="UPDATED_AT"/>
    <result property="tagId" column="TAG_ID"/>
    <result property="searchType" column="SEARCH_TYPE"/>
    <result property="searchValue" column="SEARCH_VALUE"/>
    <result property="sDate" column="S_DATE"/>
    <result property="eDate" column="E_DATE"/>
    <!-- CompanyVO -->
    <result property="companyCode" column="COMPANY_CODE"/>
    <result property="companyName" column="COMPANY_NAME"/>
    <result property="userType" column="USER_TYPE"/>
    <result property="dirMb" column="DIR_MB"/>
    <result property="dirRegDt" column="DIR_REG_DT"/>
    <result property="todayCnt" column="TODAY_CNT"/>
    <result property="rsrqAvg" column="RSRQ_AVG"/>
    <!-- OrgVO -->
    <result property="orgName" column="ORG_NAME"/>
</resultMap>

  <!-- SELECT: PK/회사코드 기준 조회 -->
  <select id="select" parameterType="orgVo" resultMap="OrgInfoMap">
    SELECT
      o.org_id,
      o.company_code,
      c.company_name,
      c.user_type,
      o.org_name,
      o.created_at,
      o.updated_at
    FROM TBL_ORG_INFO o
    LEFT JOIN TBL_COMPANY_INFO c
           ON o.company_code = c.company_code
    WHERE 1=1
    <if test="orgId != null and orgId neq '' ">
       AND o.org_id = #{orgId}
    </if>
    <if test="companyCode != null and companyCode neq '' ">
       AND o.company_code = #{companyCode}
    </if>
    ORDER BY o.org_name ASC
  </select>

  <!-- SELECT: 회사 코드별 목록 -->
  <select id="selectList" parameterType="orgVo" resultMap="OrgInfoMap">
    SELECT
      o.org_id,
      o.company_code,
      c.company_name,
      c.user_type,
      o.org_name,
      o.created_at,
      o.updated_at
    FROM TBL_ORG_INFO o
    LEFT JOIN TBL_COMPANY_INFO c
           ON o.company_code = c.company_code
    WHERE 1=1
    <if test="companyCode != null and companyCode neq '' ">
       AND o.company_code = #{companyCode}
    </if>
    <if test="searchType!=null and searchType neq '' and searchValue!=null and searchValue neq ''">
      <choose>
        <when test="searchType eq 'orgName' ">
          AND o.org_name LIKE CONCAT('%',#{searchValue},'%')
        </when>
        <when test="searchType eq 'companyName' or searchType eq 'company_name' ">
          AND c.company_name LIKE CONCAT('%',#{searchValue},'%')
        </when>
        <otherwise>
          AND
          (
            o.org_name LIKE CONCAT('%',#{searchValue},'%')
            OR
            c.company_name LIKE CONCAT('%',#{searchValue},'%')
          )
        </otherwise>
      </choose>
    </if>
    ORDER BY o.org_name ASC
  </select>

  <!-- INSERT: org_id 직접 입력 -->
  <insert id="insert" parameterType="orgVo">
    INSERT INTO TBL_ORG_INFO
      (org_id, company_code, org_name)
    VALUES
      (#{orgId}, #{companyCode}, #{orgName})
  </insert>

  <!-- UPDATE: PK 기준 -->
  <update id="update" parameterType="orgVo">
    UPDATE TBL_ORG_INFO
    SET
      company_code = #{companyCode},
      org_name     = #{orgName}
    WHERE org_id = #{orgId}
  </update>

  <!-- DELETE: PK 다건 삭제 -->
  <delete id="deleteChk" parameterType="java.util.HashMap">
    DELETE FROM TBL_ORG_INFO
    WHERE org_id IN
    <foreach collection="chkList" item="item" index="index" separator="," open="(" close=")">
       #{item}
    </foreach>
  </delete>

  <!-- DELETE: 회사 코드 기준 단건 삭제 -->
  <delete id="deleteByCompanyCode" parameterType="string">
    DELETE FROM TBL_ORG_INFO
    WHERE company_code = #{_parameter}
  </delete>

  <!-- DELETE: 회사 코드 기준 다건 삭제 -->
  <delete id="deleteByCompanyChk" parameterType="java.util.HashMap">
    DELETE FROM TBL_ORG_INFO
    WHERE company_code IN
    <foreach collection="chkList" item="item" index="index" separator="," open="(" close=")">
       #{item}
    </foreach>
  </delete>

</mapper>
