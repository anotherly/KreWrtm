<resultMap id="searchVoMap" type="kr.co.hivesys.search.vo.SearchVo">

    <!-- ================= tbl_last_data ================= -->

    <result property="volteNum"              column="VoLTE_NUM"/>
    <result property="version"               column="Version"/>
    <result property="modelName"             column="Device_Model"/>
    <result property="carNum"                column="CAR_NUM"/>
    <result property="location"              column="location"/>
    <result property="usimSlot"              column="USIM_SLOT"/>
    <result property="mobileIp"              column="MOBILE_IP"/>
    <result property="localIp"               column="LOCAL_IP"/>
    <result property="imei"                  column="IMEI"/>
    <result property="imsi"                  column="IMSI"/>
    <result property="mcpttNum"              column="MCPTT_NUM"/>
    <result property="currentRadioType"      column="CurrentRadioType"/>
    <result property="autoSwitchingRadio"    column="AutoSwitchingRadio"/>
    <result property="rcvDt"                 column="RCV_DT"/>
    <result property="rsrp"                  column="RSRP"/>
    <result property="rsrq"                  column="RSRQ"/>
    <result property="cellId"                column="CELL_ID"/>
    <result property="gpsLat"                column="GPS_Lat"/>
    <result property="gpsLon"                column="GPS_Lon"/>
    <result property="keywords"              column="Keyword"/>
    <result property="extraInfo"             column="Option_TXT"/>
    <result property="vncIp"                 column="VNC_IP"/>
    <result property="vncPort"               column="VNC_PORT"/>
    <result property="vncPw"                 column="VNC_PW"/>

    <!-- ================= tbl_router_info ================= -->

    <!-- ★ deviceId는 무조건 device_id 기준만 사용 -->
    <result property="deviceId"              column="device_id"/>

    <result property="deviceName"            column="device_name"/>
    <result property="modelName"             column="model_name"/>
    <result property="volteNum"              column="volte_num"/>
    <result property="keywords"              column="keywords"/>
    <result property="companyCode"           column="company_code"/>
    <result property="carNum"                column="car_num"/>
    <result property="updateDate"            column="update_date"/>
    <result property="makerPhone1"           column="maker_phone_1"/>
    <result property="makerPhone2"           column="maker_phone_2"/>
    <result property="regDate"               column="reg_date"/>
    <result property="extraInfo"             column="extra_info"/>
    <result property="createdAt"             column="created_at"/>
    <result property="createdBy"             column="created_by"/>
    <result property="updatedAt"             column="updated_at"/>
    <result property="updatedBy"             column="updated_by"/>

</resultMap>

	<select id="searchDataList" parameterType="searchVo" resultMap="searchVoMap">
	    SELECT 
	        r.device_id,
	        r.device_name,
	        r.model_name,
	        IFNULL(l.car_num,r.car_num) as car_num,
	        r.volte_num,
	        r.keywords,
	        l.version,
	        l.tc as location,
	        c.company_name  
	    FROM 
	        tbl_router_info r
	    LEFT JOIN 
	        tbl_last_data l ON r.volte_num = l.volte_num
	    LEFT JOIN 
	        tbl_company_info c ON r.company_code = c.company_code  
	
	    <where>
	        <if test="searchVal != null and searchVal != ''">
	            (
	                r.device_name LIKE CONCAT('%', #{searchVal}, '%')
	                OR r.model_name LIKE CONCAT('%', #{searchVal}, '%')
	                OR l.car_num LIKE CONCAT('%', #{searchVal}, '%')
	                OR r.volte_num LIKE CONCAT('%', #{searchVal}, '%')
	                OR r.keywords LIKE CONCAT('%', #{searchVal}, '%')
	                OR l.version LIKE CONCAT('%', #{searchVal}, '%')
	                OR c.company_name LIKE CONCAT('%', #{searchVal}, '%') 
	            )
	        </if>
	        <if test="companyCode != 'KREG' and companyCode != 'KREM' and companyCode != 'all'">
	            AND r.company_code = #{companyCode}
	        </if>
	    </where>
	
	    ORDER BY r.car_num DESC
	</select>

	
	
	
	<select id="searchRouterDataList" parameterType="searchVo" resultMap="searchVoMap">
    SELECT 
        r.device_id,
        r.device_name,
        r.model_name,
        IFNULL(l.car_num,r.car_num) as car_num,
        r.volte_num,
        r.keywords,
        l.version,
        l.tc as location
    FROM 
        tbl_router_info r
    LEFT JOIN 
        tbl_last_data l
        ON r.volte_num = l.volte_num
    WHERE 1=1
        <if test="searchVal != null and searchVal != ''">
            AND (
                r.model_name LIKE CONCAT('%', #{searchVal}, '%')
                OR l.car_num LIKE CONCAT('%', #{searchVal}, '%')
                OR r.volte_num LIKE CONCAT('%', #{searchVal}, '%')
                OR r.keywords LIKE CONCAT('%', #{searchVal}, '%')
                OR l.version LIKE CONCAT('%', #{searchVal}, '%')
            )
        </if>
        <if test="deviceName != 'all'">
            AND r.device_name = #{deviceName}
        </if>
        <if test="companyCode != 'all'">
            AND r.company_code = #{companyCode}
        </if>
    ORDER BY r.car_num DESC
</select>
	
	
	<!-- 실시간 데이터 조회 - 단말기 검색 조건 옵션 셋팅 -->
	<select id="companyTypeList" parameterType="searchVo" resultMap="searchVoMap">
		SELECT COMPANY_NAME , COMPANY_CODE
		FROM TBL_COMPANY_INFO
		WHERE 1 = 1
		<if test="companyCode != 'KREG' and companyCode != 'KREM' and companyCode !='all'" >
			AND COMPANY_CODE = #{companyCode}
		</if>
	</select>
	
	<select id="deviceNameTypeList" parameterType="searchVo" resultMap="searchVoMap">
		SELECT DEVICE_NAME
		FROM TBL_ROUTER_INFO
		WHERE 1=1
		<if test="companyCode != 'all'">
			and company_code = #{companyCode}
		</if>
		GROUP BY DEVICE_NAME
	</select>
	
	
	<!-- 장치 & 모니터링 장치 상세 정보 조회 -->
	<select id="selectDetail" parameterType="searchVo" resultMap="searchVoMap">
		SELECT 
		    r.device_id,
		    r.device_name,
		    r.model_name,
		    IFNULL(l.car_num,r.car_num) as car_num,
		    r.volte_num,
		    r.keywords,
			l.etc as extra_info,
		    l.version,
		    l.tc as location,
		    l.USIM_SLOT,
		    l.MOBILE_IP,
		    l.LOCAL_IP,
		    l.IMEI,
		    l.IMSI,
		    l.RSRP,
		    l.RSRQ,
		    l.MCPTT_NUM,
		    l.AutoSwitchingRadio,
		    l.CurrentRadioType,
		    l.CELL_ID,
		    l.GPS_Lat,
		    l.GPS_Lon,
		    l.RCV_DT    
		FROM 
		    tbl_router_info r
		LEFT JOIN 
		    tbl_last_data l
		    ON r.volte_num = l.volte_num
		WHERE r.device_id = #{deviceId}	
	</select>

	<!-- 받아온 voltenum 으로 ip port pw 조회 -->
	<select id="findVnc" parameterType="searchVo" resultMap="searchVoMap">
	    SELECT vnc_ip,vnc_port,vnc_pw from tbl_last_data
	    WHERE VoLTE_NUM = #{volteNum}	
	</select>
</mapper>